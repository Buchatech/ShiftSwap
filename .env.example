# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Mode: sqlite | postgres | mysql
DB_MODE=sqlite
DEMO_MODE=true

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shiftswap
POSTGRES_USER=shiftswap_user
POSTGRES_PASSWORD=your_secure_password

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=shiftswap
MYSQL_USER=shiftswap_user
MYSQL_PASSWORD=your_secure_password

# SQLite Configuration (used in demo mode)
SQLITE_DB_PATH=./data/shiftswap.db

# Session Configuration
SESSION_SECRET=your_random_secure_session_secret_change_this_in_production

# Notification Services (Optional for MVP)
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_ENABLED=false

# Application Settings
OVERTIME_THRESHOLD_HOURS=40
ESCALATION_HOURS_BEFORE_SHIFT=4
AUDIT_RETENTION_DAYS=90
